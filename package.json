{
  "name": "simulatore-bilancia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Weighing terminal simulator that sends weight strings over TCP/UDP (client or server), with a React UI, ACK/NAK, error injection and a spec-driven development workflow.",
  "license": "MIT",
  "author": "robycremo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robycremo/simulatore-bilancia.git"
  },
  "homepage": "https://github.com/robycremo/simulatore-bilancia#readme",
  "bugs": {
    "url": "https://github.com/robycremo/simulatore-bilancia/issues"
  },
  "keywords": [
    "scale-simulator",
    "weighing",
    "weighbridge",
    "industrial-automation",
    "tcp",
    "udp",
    "nodejs",
    "react",
    "test-tool",
    "spec-driven-development"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "listen": "node server/transport/listen.js",
    "check:flow": "node scripts/check-flow.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 --test-force-exit \"test/*.test.js\"",
    "prod": "npm run build && npm start",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  }
}
