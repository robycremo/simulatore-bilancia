{
  "name": "simulatore-bilancia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Simulatore di terminale di pesatura con invio stringa peso su IP (Node.js + React)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "listen": "node server/transport/listen.js",
    "check:flow": "node scripts/check-flow.mjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "prod": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
